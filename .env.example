# Tracespend configuration. Every variable here is optional: the sundial chart
# works with none of them set. They configure the Ask-the-data Q&A pipeline and
# the runtime activity log.

# --- Model endpoint (enables answering) ---
# One endpoint, spoken to in the OpenAI chat-completions wire format. Which
# company answers is decided entirely here — there is no provider switch in the
# code. With no key set the chart still works, and asking returns a clear
# "AI is not configured" response. The model NEVER computes a number: it picks a
# query, and the query worker computes every figure. Every call is made at
# temperature 0 — answering is meant to be reproducible, not creative.

# The API key for whichever endpoint you point at. No default — this is the one
# variable you must set to enable answering.
MODEL_API_KEY=your-key-here

# Where to send chat-completion requests. Defaults to OpenAI.
#   OpenAI     https://api.openai.com/v1     (default)
#   Anthropic  https://api.anthropic.com/v1  (its OpenAI-compatible endpoint)
#   OpenRouter https://openrouter.ai/api/v1
#   Groq       https://api.groq.com/openai/v1
#   Ollama     http://localhost:11434/v1     (local, no hosted key needed)
# MODEL_BASE_URL=https://api.openai.com/v1

# The model to ask, named as that endpoint names it. Defaults to gpt-4.1-nano,
# which is cheap AND accepts temperature 0. The gpt-5 nano/mini models refuse
# any temperature but their own default, so answers vary between identical
# questions on those — see docs/adr/0001-openai-wire-format-for-model-calls.md.
# Examples: gpt-4.1-nano · gpt-4o-mini · claude-haiku-4-5-20251001 · llama3.2
# MODEL_NAME=gpt-4.1-nano

# --- Local server ---
# Port for `npm run server`. Vite (npm run dev) proxies /api here.
PROSE_PORT=8787

# AI_INPUT_LOG: a local development tool. Set it to a file path to record exactly
# what is sent to the model, so you can verify the model never receives a number.
# Unset (the default) it writes nothing at all — which is what lets the app run on
# a read-only filesystem. Not intended for deployment.
# AI_INPUT_LOG=logs/ai-inputs.log

# ASK_TIMEOUT_MS: how long a question may take before the caller is told to retry.
# Defaults to 12000. Keep it below the host's function limit (vercel.json allows
# 30s) so the visitor sees our retry message rather than a platform timeout.
# ASK_TIMEOUT_MS=12000

# --- Runtime activity log (optional, off by default) ---
# VITE_SERVER_ACTIVITY_LOG: whether the BROWSER sends interactions to the server.
# Off unless set to 1. Interactions are always recorded in the browser itself;
# this only controls the network call. Read at BUILD time like every VITE_ var,
# so changing it needs a rebuild, not just a restart.
# VITE_SERVER_ACTIVITY_LOG=1

# DATABASE_URL: when set, the interaction log is stored in Postgres (durable
# across restarts/redeploys). Leave unset locally to use logs/activity.log.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# LOG_CLEAR_TOKEN: secret that gates the hidden log admin endpoints:
#   POST /api/log/clear   -> wipe the log back to zero
#   GET  /api/log/export  -> download the full log (newline-JSON)
# Without it, both return 404. Generate with: openssl rand -hex 32
# NEVER commit the real value (this file is an example; .env is gitignored).
# LOG_CLEAR_TOKEN=replace-with-a-long-random-string
